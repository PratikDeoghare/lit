#h2{review.py}

Review shows what was filled, checks it again, asks for a second opinion if wanted, and lets the
author approve each fill or put its hint back.

#py review: header and the second-opinion prompt{
  Review is the other half of fill: the author returns to a program that was filled in and wants
  to see what happened. The system text for the second opinion asks for a verdict in a fixed form,
  so that the answer can be parsed and the exit status can depend on it.

  ```
  #!/usr/bin/env python3
  """Review what fill.py wrote into a literate program.

      python review.py prog.lit                    # the fills waiting for review, with automatic checks
      python review.py prog.lit --all --full       # every fill ever made, with its code
      python review.py prog.lit --check 'go vet ./...' --ai --agent 'claude -p'
      python review.py prog.lit --approve f-3142cc | --approve-all | --reject f-3142cc

  Each fill is checked without a model: its code is still in the program, has no placeholders, the program
  still parses and tangles, generated .py/.json/.go files are valid, and --check CMD passes on the tangled
  program.  --ai asks an agent for a second opinion (VERDICT: ok / concerns / reject) from the same context
  fill.py used.  --reject puts the original hint back, so the gap is open again.
  """
  import argparse
  import json
  import sys
  import os

  sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
  from tangle import Source  # noqa: E402
  from fill import (check_code, check_program, find_hints, load_fills, make_agent,  # noqa: E402
                    record_status, run_check, trunc)

  REVIEW_SYSTEM = """You review code that an assistant wrote to fill one gap in a literate program (prose interleaved with named code chunks).
  You are shown the context, the hint the author left, and the code that was inserted. Judge whether the code does what the hint and the surrounding prose ask, fits the code around it (names, types, errors, style), and could be wrong in a way a compiler or a quick test would not catch.
  Answer in this exact form:
  VERDICT: ok | concerns | reject
  then at most six short lines of reasons, one issue per line, each starting with "- "."""
  ```
}

#py review: checking a fill{
  A fill is checked again, not trusted from the moment it was written. Is its text still in the
  document, once? Does the code pass the checks of fill? Does the program still tangle? Does the
  author's command still pass? The answer is a list of findings, each an error or a warning.

  ```
  def where_is(src, fill):
      """Does the inserted text still stand in the program, exactly once?"""
      n = src.text.count(fill["inserted"])
      return n


  def assess(src, fill, check="", agent=None, budget=24000):
      """-> (findings [(level, text)], ai verdict or '')"""
      fs = []
      n = where_is(src, fill)
      if n == 0:
          fs.append(("warn", "the inserted text is no longer in the program (edited since, or reverted)"))
      elif n > 1:
          fs.append(("warn", "the inserted text occurs %d times; --reject cannot tell which is the fill" % n))
      fs += check_code(fill["code"].split("\n"))
      fs += check_program(src.text)
      if check and not any(l == "error" for l, _ in fs):
          fs += run_check(src.text, check)
      verdict = ""
      if agent:
          verdict = ai_review(agent, src, fill, budget)
      return fs, verdict
  ```
}

#py review: the second opinion{
  A second assistant is asked to judge the code against the hint and the text around it. Its
  verdict is one of three words, and an unreadable answer counts as concerns, not as approval. It
  never replaces reading the code.

  ````
  def ai_review(ask, src, fill, budget):
      ctx = "Chunk: «%s» (%s line %d)\nHint: %s\n\nProse and code around the gap now:\n" % (
          fill["chunk"], fill["file"], fill["line"], fill["hint"] or "(none)")
      at = src.text.find(fill["inserted"])
      if at >= 0:
          ctx += src.text[max(0, at - budget // 4):at + len(fill["inserted"]) + budget // 8]
      user = ctx + "\n\nInserted code:\n```\n" + fill["code"] + "\n```\n\nGive your verdict."
      reply = ask(REVIEW_SYSTEM, user)
      first = next((l for l in reply.split("\n") if l.strip().upper().startswith("VERDICT")), "")
      word = first.partition(":")[2].strip().lower().split(" ")[0] if first else ""
      return word if word in ("ok", "concerns", "reject") else "concerns"
  ````
}

#py review: putting a hint back{
  Rejecting restores the original hint in the place of the inserted text. It is refused when the
  inserted text is no longer there exactly once, because then it cannot be told which part of the
  document is the fill.

  ```
  def reject(src, fill):
      n = where_is(src, fill)
      if n != 1:
          raise ValueError("cannot reject %s: its text %s" % (fill["id"], "is not in the program any more" if not n else "occurs %d times" % n))
      at = src.text.find(fill["inserted"])
      src.write_back(src.text[:at] + fill["orig"] + src.text[at + len(fill["inserted"]):])
  ```
}

#py review: command line{
  The default is to show the fills that wait for a decision, with their findings. Approving only
  records that somebody read the code; rejecting changes the document.

  ```
  def main(argv=None):
      ap = argparse.ArgumentParser(prog="review.py", description="Review the fills fill.py made.")
      ap.add_argument("source")
      ap.add_argument("--all", action="store_true", help="include approved and rejected fills")
      ap.add_argument("--check", default="", help="run this command on the tangled program")
      ap.add_argument("--ai", action="store_true", help="ask an agent for a second opinion")
      ap.add_argument("--agent", default="")
      ap.add_argument("--model", default="")
      ap.add_argument("--approve", metavar="ID", nargs="+")
      ap.add_argument("--approve-all", action="store_true")
      ap.add_argument("--reject", metavar="ID", nargs="+")
      ap.add_argument("--json", action="store_true")
      ap.add_argument("--full", action="store_true", help="show the inserted code")
      a = ap.parse_args(argv)

      src = Source.read(a.source)
      fills = load_fills(src)
      byid = {f["id"]: f for f in fills}

      if a.reject:
          code = 0
          for fid in a.reject:
              f = byid.get(fid)
              if not f:
                  print("review: no fill %s" % fid, file=sys.stderr)
                  code = 2
                  continue
              src = Source.read(a.source)
              try:
                  reject(src, f)
              except ValueError as e:
                  print("review: %s" % e, file=sys.stderr)
                  code = code or 1
                  continue
              record_status(src, f["id"], "rejected")
              print("%s rejected: the hint is back in the program" % f["id"])
          return code
      if a.approve or a.approve_all:
          todo = [f for f in fills if f["status"] == "pending"] if a.approve_all else [byid.get(i) for i in a.approve]
          if None in todo:
              print("review: no such fill among %s" % " ".join(a.approve), file=sys.stderr)
              return 2
          for f in todo:
              record_status(src, f["id"], "approved")
              print("%s approved" % f["id"])
          return 0

      shown = [f for f in fills if a.all or f["status"] == "pending"]
      ask = make_agent(a.agent, a.model)[1] if a.ai else None
      results, bad = [], 0
      for f in shown:
          fs, verdict = assess(src, f, a.check, ask) if f["status"] == "pending" else ([], "")
          if verdict:
              record_status(src, f["id"], f["status"], verdict)
          bad += any(l == "error" for l, _ in fs) or verdict == "reject"
          results.append((f, fs, verdict))
      if a.json:
          print(json.dumps([{**{k: f[k] for k in ("id", "status", "chunk", "file", "line", "hint", "agent", "attempts")},
                             "code": f["code"], "findings": [{"level": l, "message": m} for l, m in fs], "verdict": v or f.get("verdict", "")}
                            for f, fs, v in results], indent=2, ensure_ascii=False))
          return 1 if bad else 0
      if not results:
          print("nothing to review" + ("" if a.all else " (--all shows approved and rejected fills too)"))
          return 0
      for f, fs, verdict in results:
          print("%s  %s  «%s»  %s:%d  [%s]" % (f["id"], f["status"], f["chunk"], f["file"], f["line"], f["agent"]))
          if f["hint"]:
              print("    hint: " + trunc(f["hint"], 100))
          if a.full:
              print("    " + f["code"].replace("\n", "\n    "))
          else:
              print("    %d line(s)" % (f["code"].count("\n") + 1))
          for l, m in fs:
              print("    %s: %s" % (l, m.replace("\n", "\n        ")))
          if verdict:
              print("    ai verdict: " + verdict)
          if not fs and verdict in ("", "ok"):
              print("    checks passed")
      print("%d fill(s) shown%s" % (len(results), "; some need attention" if bad else ""))
      return 1 if bad else 0


  if __name__ == "__main__":
      sys.exit(main())
  ```
}

#internal/skill/files/scripts/review.py{
  The file is its parts, in the order of the source.

  ```
  <<<py review: header and the second-opinion prompt>>>


  <<<py review: checking a fill>>>


  <<<py review: the second opinion>>>


  <<<py review: putting a hint back>>>


  <<<py review: command line>>>
  ```
}

#h2{Why a second implementation}

The Go program is for people: one binary to install, fast, with a test suite. The scripts are
for assistants, and an assistant works in an environment where Python is present and a Go
toolchain or a downloaded binary may not be. Two implementations can drift apart, so the build
checks the part that is easiest to check, that the scripts and the program tangle the book into
the same files and that lint agrees with lint, and the scripts have tests of their own. They
read and write the same documents and the same `fills.jsonl`, so a document filled by one can be
reviewed by the other. What the two do not share is the sourcemap, which counts characters in
one and bytes in the other.

#h2{Testing the scripts}

The tests run the scripts as an assistant would, from the command line, with fake assistants:
small programs that read the prompt on standard input and print a fixed reply, or a reply that
depends on whether the prompt says an earlier answer was rejected. They cover the prompt, a fill
that works, one that is rejected for a placeholder and retried with the error, one with a syntax
error that must never be written, a refusal, a check command that vetoes, review, approval and
rejection, and the notes that tangle and weave give about open hints.

#internal/skill/pytests/test_fill_review.py{
  The file is the tests, in the order described above.

  ````
  #!/usr/bin/env python3
  """Tests of fill.py and review.py with fake agents (small scripts that read the prompt on stdin).

      python test_fill_review.py [SCRIPTS_DIR]
  """
  import json
  import os
  import subprocess
  import sys
  import tempfile
  import unittest

  HERE = os.path.dirname(os.path.abspath(__file__))
  SCRIPTS = os.path.abspath(sys.argv.pop(1)) if len(sys.argv) > 1 else os.path.join(HERE, "..", "files", "scripts")

  PROG = """#h1{Counter}
  Counts up to a limit.

  #count.py{
    ```
    def count(n):
        \<<<loop>>>

    print(count(3))
    ```
  }

  #loop{
    Add the numbers one by one.
    #agent-fill-in{ return the sum of 1..n with a for loop }
  }

  #extra{
    Second gap, in a chunk nobody asked about.
    #agent-fill-in{ say hello }
  }
  """

  FENCE = "`" * 3
  GOOD = FENCE + "\ntotal = 0\nfor i in range(1, n + 1):\n    total += i\nreturn total\n" + FENCE
  _n = [0]


  def agent(body):
      """A fake agent: a command whose python source `body` sees the prompt as `p` and prints the reply."""
      _n[0] += 1
      path = os.path.join(tempfile.gettempdir(), "fake_agent_%d_%d.py" % (os.getpid(), _n[0]))
      with open(path, "w") as f:
          f.write("import sys\np = sys.stdin.read()\n" + body + "\n")
      return "%s %s" % (sys.executable, path)


  def rd(*parts):
      with open(os.path.join(*parts), encoding="utf-8") as f:
          return f.read()


  def say(text):
      return "print(%r)" % text


  def run(name, *args, cwd):
      p = subprocess.run([sys.executable, os.path.join(SCRIPTS, name + ".py"), *args], cwd=cwd, capture_output=True, text=True)
      return p.returncode, p.stdout + p.stderr


  class FillReview(unittest.TestCase):
      def setUp(self):
          self.tmp = tempfile.TemporaryDirectory()
          self.d = self.tmp.name
          with open(os.path.join(self.d, "p.lit"), "w", encoding="utf-8") as f:
              f.write(PROG)

      def tearDown(self):
          self.tmp.cleanup()

      def lit(self):
          return rd(self.d, "p.lit")

      def test_list_numbers_the_hints_in_document_order(self):
          code, out = run("fill", "p.lit", "--list", cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("«loop»", out.split("\n")[0])
          self.assertIn("«extra»", out.split("\n")[1])

      def test_the_prompt_shows_prose_use_site_and_tangled_file_with_the_gap_marked(self):
          code, out = run("fill", "p.lit", "--dry-run", cwd=self.d)
          self.assertEqual(code, 0, out)
          for want in ("Add the numbers one by one", "def count(n):", "FILL IN HERE", "Ends up in: count.py", "Language: py"):
              self.assertIn(want, out)
          self.assertNotIn("say hello", out.split("=== the chunk")[1].split("=== the tangled")[0])

      def test_fill_inserts_code_keeps_the_hint_as_prose_and_the_program_tangles(self):
          code, out = run("fill", "p.lit", "--only", "0", "--agent", agent(say(GOOD)), cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("return the sum of 1..n with a for loop", self.lit())
          self.assertEqual(self.lit().count("#agent-fill-in"), 1)
          code, out = run("tangle", "p.lit", "out", cwd=self.d)
          self.assertEqual(code, 0, out)
          ns = subprocess.run([sys.executable, os.path.join(self.d, "out", "count.py")], capture_output=True, text=True)
          self.assertEqual(ns.stdout.strip(), "6", ns.stdout + ns.stderr)

      def test_a_placeholder_is_rejected_and_the_agent_gets_the_error_on_retry(self):
          body = "print(%r if 'rejected' not in p else %r)" % (FENCE + "\n# TODO\n" + FENCE, GOOD)
          code, out = run("fill", "p.lit", "--only", "0", "--agent", agent(body), cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("attempt 1 failed", out)
          self.assertNotIn("TODO", self.lit())

      def test_a_syntax_error_is_never_written(self):
          code, out = run("fill", "p.lit", "--only", "0", "--retries", "0", "--agent", agent(say(FENCE + "\nreturn (\n" + FENCE)), cwd=self.d)
          self.assertNotEqual(code, 0)
          self.assertEqual(self.lit(), PROG)

      def test_cannot_leaves_the_program_alone(self):
          code, out = run("fill", "p.lit", "--only", "0", "--agent", agent(say("CANNOT: no idea")), cwd=self.d)
          self.assertNotEqual(code, 0)
          self.assertIn("no idea", out)
          self.assertEqual(self.lit(), PROG)

      def test_check_command_runs_on_the_tangled_program_and_can_veto(self):
          body = say(GOOD)
          code, out = run("fill", "p.lit", "--only", "0", "--retries", "0", "--check-each", "--check", "false", "--agent", agent(body), cwd=self.d)
          self.assertNotEqual(code, 0)
          self.assertEqual(self.lit(), PROG)
          code, out = run("fill", "p.lit", "--only", "0", "--check-each", "--check", "python3 count.py | grep -q 6", "--agent", agent(body), cwd=self.d)
          self.assertEqual(code, 0, out)

      def test_all_hints_filled_in_order_and_each_fill_sees_the_previous(self):
          body = "print('```\\nreturn 1\\n```' if 'say hello' not in p else '```\\nprint(\"hello\")\\n```')"
          code, out = run("fill", "p.lit", "--agent", agent(body), cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("0 hint(s) still open", out)

      def test_review_lists_approves_and_rejects(self):
          body = say(GOOD)
          run("fill", "p.lit", "--only", "0", "--agent", agent(body), cwd=self.d)
          code, out = run("review", "p.lit", "--full", "--check", "python3 count.py", cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("pending", out)
          self.assertIn("checks passed", out)
          fid = json.loads(rd(self.d, "p.lit.fills.jsonl").split("\n")[0])["id"]
          code, out = run("review", "p.lit", "--ai", "--agent", agent(say("VERDICT: reject\n- wrong")), cwd=self.d)
          self.assertEqual(code, 1, out)
          code, out = run("review", "p.lit", "--reject", fid, cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertEqual(self.lit().count("#agent-fill-in"), 2)
          self.assertEqual(self.lit(), PROG.replace("{ return the sum", "{ return the sum"))
          code, out = run("review", "p.lit", cwd=self.d)
          self.assertIn("nothing to review", out)

      def test_approve_all_marks_pending_fills(self):
          body = say(FENCE + "\nreturn 1\n" + FENCE)
          run("fill", "p.lit", "--agent", agent(body), cwd=self.d)
          code, out = run("review", "p.lit", "--approve-all", cwd=self.d)
          self.assertEqual(code, 0, out)
          code, out = run("review", "p.lit", "--json", cwd=self.d)
          self.assertEqual(json.loads(out), [])
          code, out = run("review", "p.lit", "--all", "--json", cwd=self.d)
          self.assertEqual([f["status"] for f in json.loads(out)], ["approved", "approved"])

      def test_tangle_and_weave_leave_hints_out_and_say_so(self):
          code, out = run("tangle", "p.lit", "out", cwd=self.d)
          self.assertIn("2 #agent-fill-in hint(s) still open", out)
          code, out = run("weave", "p.lit", "-o", "w", "--only", "html", cwd=self.d)
          self.assertEqual(code, 0, out)
          self.assertIn("to be filled in by an agent", rd(self.d, "w", "p.html"))


  if __name__ == "__main__":
      unittest.main(verbosity=1)
  ````
}
